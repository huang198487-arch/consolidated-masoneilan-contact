@model ConsolidatedMasoneilanContact.Models.SiteContent

<section class="brands" id="brands" aria-labelledby="brands-title">
    <div class="page-shell">
        <div class="section-intro">
            <div>
                <p class="section-label">@Model.BrandSectionLabel</p>
                <h2 id="brands-title">@Model.BrandSectionTitle</h2>
            </div>
            <p class="section-intro__summary">@Model.BrandSectionSummary</p>
        </div>

        <div class="brand-list">
            @foreach (var brand in Model.Brands)
            {
                <article class="brand-item">
                    <div class="brand-item__heading">
                        <span class="brand-item__number">@brand.Number</span>
                        <div>
                            <p class="brand-item__chinese">@brand.ChineseName</p>
                            <h3>@brand.Name</h3>
                        </div>
                    </div>
                    <p class="brand-item__product">@brand.ProductLabel</p>
                    <p class="brand-item__description">@brand.Description</p>
                    <figure class="brand-item__media">
                        <img src="@brand.ImagePath"
                             alt="@brand.ImageAlt"
                             width="1320"
                             height="627"
                             loading="lazy" />
                    </figure>
                </article>
            }
        </div>
    </div>
</section>
