@model ConsolidatedMasoneilanContact.Models.SiteContent

<section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="page-shell contact__layout">
        <div class="contact__intro">
            <p class="section-label section-label--light">@Model.ContactSectionLabel</p>
            <h2 id="contact-title">@Model.ContactHeading</h2>
            <p>@Model.ContactSummary</p>
        </div>

        <div class="contact-sheet">
            <div class="contact-sheet__rail" aria-hidden="true"></div>
            <div class="contact-sheet__content">
                <div class="contact-person">
                    <div>
                        <p class="contact-person__role">@Model.Contact.Role</p>
                        <p class="contact-person__name">@Model.Contact.Name</p>
                    </div>
                    <span class="contact-person__status">可直接联系</span>
                </div>

                <div class="contact-methods">
                    <div class="contact-method">
                        <span class="contact-method__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M7.2 3.5 9.5 8l-2 1.7c1.2 2.8 3.9 5.5 6.8 6.8l1.7-2 4.5 2.3-.8 2.5c-.3.9-1.1 1.5-2 1.5C10 20.8 3.2 14 3.2 6.3c0-.9.6-1.7 1.5-2z" />
                            </svg>
                        </span>
                        <div class="contact-method__body">
                            <span>手机</span>
                            <a href="@Model.Contact.PhoneUri" data-contact-text>@Model.Contact.DisplayPhone</a>
                        </div>
                        <button class="copy-button" type="button" data-copy-value="@Model.Contact.DisplayPhone" aria-label="复制电话号码" title="复制电话号码">
                            <svg class="copy-button__copy" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="8" y="8" width="11" height="11" rx="1.5" />
                                <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" />
                            </svg>
                            <svg class="copy-button__check" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m5 12 4.3 4.3L19 6.5" />
                            </svg>
                        </button>
                    </div>

                    <div class="contact-method">
                        <span class="contact-method__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="5" width="18" height="14" rx="1.5" />
                                <path d="m4 7 8 6 8-6" />
                            </svg>
                        </span>
                        <div class="contact-method__body">
                            <span>邮箱</span>
                            <a href="mailto:@Model.Contact.Email" data-contact-text>@Model.Contact.Email</a>
                        </div>
                        <button class="copy-button" type="button" data-copy-value="@Model.Contact.Email" aria-label="复制邮箱地址" title="复制邮箱地址">
                            <svg class="copy-button__copy" viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="8" y="8" width="11" height="11" rx="1.5" />
                                <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8" />
                            </svg>
                            <svg class="copy-button__check" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m5 12 4.3 4.3L19 6.5" />
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="contact-actions">
                    <a class="button button--primary" href="@Model.Contact.PhoneUri">
                        拨打电话
                        <span class="button__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </span>
                    </a>
                    <a class="button button--outline" href="mailto:@Model.Contact.Email">发送邮件</a>
                </div>

                <p class="copy-status" role="status" aria-live="polite"></p>
            </div>
        </div>
    </div>
</section>
